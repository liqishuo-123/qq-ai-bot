# 复制为 .env 后填写。不要把 .env 提交到 Git。

# NoneBot
DRIVER=~fastapi+~websockets
HOST=127.0.0.1
PORT=8080
COMMAND_START=["/"]
SUPERUSERS=["你的QQ号"]
NICKNAME=["大肥鱼"]
# 本地控制台 token；只在本机访问，不要泄露
ADMIN_TOKEN=

# 模型服务商（双击「配置向导.bat」选一家，一般不用手改）
# LLM_PROVIDER 可选：
#   dashscope 阿里云百炼 | deepseek DeepSeek 官方 | siliconflow 硅基流动
#   zhipu 智谱 GLM | moonshot 月之暗面 | ark 火山方舟 | hunyuan 腾讯混元
#   minimax MiniMax | openai | gemini | ollama 本地 | custom 自定义中转
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=60

# 生成参数
# THINKING=false 表示不要让模型思考。有些模型关不掉，会自动忽略
THINKING=false
MAX_OUTPUT_TOKENS=120
TEMPERATURE=0.9
STREAM_REPLIES=false

# 旧版配置（v0.1 及更早）。留着仍然能读，不用手动迁移
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=

DAILY_TOKEN_BUDGET=0
TOKEN_WARN_RATIO=0.8

# NapCat / OneBot 11
# NapCat 开启正向 WebSocket，默认地址如下
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
ONEBOT_ACCESS_TOKEN=

# 本地数据
DATA_DIR=data
PERSONA_FILE=config/personas/dafeiyu.yaml
PLUGINS_FILE=config/plugins.yaml

# 上下文与回复
CONTEXT_MESSAGES=8
SUMMARY_TRIGGER=30
SUMMARY_KEEP=12
MAX_CONTEXT_CHARS=8000
GROUP_FOLLOWUP_WINDOW=90
GROUP_COOLDOWN=2.0
REPLY_MAX_BUBBLES=3
REPLY_MAX_CHARS=500
REPLY_BUBBLE_DELAY=0.35
TYPING_DELAY_MIN=0.1
TYPING_DELAY_MAX=0.5

# 记忆与图片
MEMORY_ENABLED=true
MEMORY_EXTRACT_EVERY=12
MEMORY_LIMIT=3
MEMORY_TTL_DAYS=90
# 风格学习：观察其他人的表达方式，逐步调整语感
STYLE_LEARNING_ENABLED=true
STYLE_AUTO_APPLY=true
STYLE_GROUP_ENABLED=true
STYLE_PRIVATE_ENABLED=true
STYLE_LEARN_EVERY=50
STYLE_MIN_SAMPLES=20
STYLE_MAX_SAMPLES=120
STYLE_MAX_PER_USER=40
STYLE_MIN_CONFIDENCE=0.35
STYLE_INJECT_MAX_CHARS=700
STYLE_RETENTION_VERSIONS=20
# 去 AI 化闸门：回复发出前检测 AI 腔，超阈值改写一次，失败发原文
DEAI_ENABLED=true
# 只记录不改写：先观察几天命中分布，再调阈值、打开改写
DEAI_RECORD_ONLY=false
DEAI_LIGHT_THRESHOLD=20
DEAI_HEAVY_THRESHOLD=50
DEAI_TIMEOUT=8
# 回复反馈：观察对方在窗口内是否接话/追问/吐槽，只记行为不记原文
FEEDBACK_ENABLED=true
FEEDBACK_OBSERVE_SECONDS=300
FEEDBACK_PRIVATE_ENABLED=true
# 自我批评：定期审视自己的回复+反馈，打画像补丁，写入风格进化日志
SELFREVIEW_ENABLED=true
SELFREVIEW_INTERVAL_MESSAGES=120
SELFREVIEW_MIN_GAP_MINUTES=30
SELFREVIEW_NEG_TRIGGER=3
STYLE_EVOLUTION_BRAIN=true
IMAGE_ENABLED=true
IMAGE_MAX_BYTES=8000000
# 默认阻止图片 URL 指向本机/内网，避免 SSRF。只有本地 NapCat 返回内网图片地址时才打开。
IMAGE_ALLOW_PRIVATE_HOSTS=false

# 表情包库：只自动收别人发的表情/动画表情，控制台也可以上传
STICKER_LIBRARY_ENABLED=true
STICKER_INGEST_ENABLED=true
STICKER_AUTO_TAG=true
STICKER_AUTO_SEND=true
STICKER_AUTO_CHANCE=0.35
STICKER_COOLDOWN_SECONDS=300
STICKER_HOURLY_LIMIT=4
STICKER_DAILY_LIMIT=12
STICKER_MAX_COUNT=300
STICKER_MAX_BYTES=3000000
STICKER_CATALOG_LIMIT=30
STICKER_DIR=data/stickers

# 技能、大脑、主页与空间
SKILLS_ENABLED=true
# 大肥鱼可以自己判断要不要接群友的活；控制台“自主权限”里可以覆盖
AUTONOMY_ENABLED=true
AUTONOMY_CACHE_SECONDS=45
# 探索模式默认关；控制台打开后自主判断全放行，只读探测 QQ 能力
EXPLORE_ENABLED=false
EXPLORE_PROBE_LIMIT=20
EXPLORE_TIMEOUT=15
EXPLORE_INTERVAL_MINUTES=180
EXPLORE_STARTUP_DELAY_SECONDS=60
BRAIN_ENABLED=true
BRAIN_CAPTURE_ENABLED=true
# 默认是项目下 data/brain；换 DATA_DIR 时建议一起改
# BRAIN_DIR=data/brain
BRAIN_CAPTURE_MAX_MEMORIES=20
BRAIN_CONTEXT_CHARS=700
BRAIN_SEARCH_LIMIT=3
BRAIN_MAX_NOTES=2000
BRAIN_MAX_NOTE_BYTES=65536
SOCIAL_AUTO_ENABLED=true
# 先手动验证主页/空间，确认 NapCat 接口正常后再改 true
PROFILE_AUTO_ENABLED=false
PROFILE_AUTO_APPLY=true
PROFILE_UPDATE_DAYS=7
PROFILE_FIRST_DELAY_MINUTES=30
QZONE_AUTO_ENABLED=false
QZONE_INTERVAL_HOURS=24
QZONE_MAX_PER_DAY=1
QZONE_FIRST_DELAY_MINUTES=60
QZONE_QUIET_START=0
QZONE_QUIET_END=8
QZONE_UGC_RIGHT=1
QZONE_MAX_CHARS=300
QZONE_WEB_ENABLED=true
QZONE_RATE_SECONDS=3
QZONE_COMMENT_HOURLY_LIMIT=20
QZONE_REQUEST_TIMEOUT=15

# 频道：auto 优先 NapCat 同账号插件，失败再走官方频道机器人
GUILD_BACKEND=auto
GUILD_ID=
GUILD_CHANNEL_ID=
GUILD_BOT_APPID=
GUILD_BOT_SECRET=
GUILD_BOT_TOKEN=
GUILD_TIMEOUT=15
GUILD_RATE_SECONDS=3